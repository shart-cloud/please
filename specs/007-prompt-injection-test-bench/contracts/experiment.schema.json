{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://please.local/schemas/bench/experiment-v1.json",
  "title": "PLEASE bench experiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "version", "pack_path", "system_paths", "exposure_paths", "repetitions", "execution_mode", "limits"],
  "properties": {
    "schema_version": {"const": "please-bench-experiment/v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "pack_path": {"type": "string", "minLength": 1},
    "system_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "exposure_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 1000},
    "execution_mode": {"enum": ["offline", "network_allowed"]},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_input_bytes", "max_request_bytes", "max_stdout_bytes", "max_stderr_bytes", "startup_timeout_ms", "case_timeout_ms", "max_restarts", "max_in_flight"],
      "properties": {
        "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "max_request_bytes": {"type": "integer", "minimum": 1, "maximum": 41943040},
        "max_stdout_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "max_stderr_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "startup_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
        "case_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
        "max_restarts": {"type": "integer", "minimum": 0, "maximum": 100, "description": "Replacement process starts permitted after the initial start."},
        "max_in_flight": {"const": 1}
      }
    }
  }
}
