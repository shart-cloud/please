{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://please.local/schemas/bench/system-v1.json",
  "title": "PLEASE bench system v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system_id", "version", "adapter_version", "configuration_identity", "supported_surfaces", "requires_trusted_context", "deterministic", "review_authority", "operating_point", "identities", "adapter", "normalizers"],
  "properties": {
    "schema_version": {"const": "please-bench-system/v1"},
    "system_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "configuration_identity": {"type": "string", "minLength": 1},
    "supported_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["artifact_detection", "contextual_alignment"]}},
    "requires_trusted_context": {"type": "boolean"},
    "deterministic": {"type": "boolean"},
    "review_authority": {"type": "string", "minLength": 1},
    "operating_point": {
      "type": "object", "additionalProperties": false, "required": ["threshold", "description"],
      "properties": {"threshold": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}
    },
    "identities": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "model": {"type": "string"}, "prompt": {"type": "string"},
        "rule_set": {"type": "string"}, "runtime": {"type": "string"}
      }
    },
    "adapter": {"$ref": "#/$defs/adapter"},
    "normalizers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/normalizer"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "mode", "profile", "threshold", "provenance_mapping", "rules", "disabled_rules"],
          "properties": {
            "kind": {"const": "please"}, "mode": {"enum": ["product", "mechanism"]},
            "profile": {"enum": ["enforcement", "reference_analysis"]}, "threshold": {"enum": ["none", "low", "medium", "high", "critical"]},
            "provenance_mapping": {"type": "object", "additionalProperties": {"enum": ["unspecified", "caller_provided", "user_input", "tool_response"]}},
            "rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "disabled_rules": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "program", "args", "executable_sha256", "environment", "network_capable"],
          "properties": {
            "kind": {"const": "subprocess"}, "program": {"type": "string", "minLength": 1},
            "args": {"type": "array", "items": {"type": "string"}},
            "sandbox_command": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
            "executable_sha256": {"$ref": "#/$defs/sha256"},
            "environment": {"type": "object", "propertyNames": {"pattern": "^[A-Z0-9_]+$"}, "additionalProperties": {"type": "string"}},
            "network_capable": {"type": "boolean"}
          }
        }
      ]
    },
    "normalizer": {
      "type": "object", "additionalProperties": false,
      "required": ["normalizer_id", "version", "surface", "mapping"],
      "properties": {
        "normalizer_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "surface": {"enum": ["artifact_detection", "contextual_alignment"]},
        "mapping": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "please_artifact_v1"}}},
            {"type": "object", "additionalProperties": false, "required": ["kind", "positive_labels", "negative_labels"], "properties": {
              "kind": {"const": "native_v1"},
              "positive_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "negative_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }}
          ]
        }
      }
    }
  }
}
