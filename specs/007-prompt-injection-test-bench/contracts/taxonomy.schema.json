{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://please.local/schemas/bench/taxonomy-v1.json",
  "title": "PLEASE bench taxonomy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomy_id", "version", "techniques", "delivery_vectors"],
  "properties": {
    "schema_version": {"const": "please-bench-taxonomy/v1"},
    "taxonomy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "techniques": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "delivery_vectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
